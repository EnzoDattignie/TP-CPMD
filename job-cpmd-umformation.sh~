#SBATCH --output cpmd%j.out
#SBATCH --error=cpmd_fm2pn_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:02:00
