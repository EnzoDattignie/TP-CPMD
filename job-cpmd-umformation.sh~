echo "------------------------------------------------------"
echo "M2 PhysNum -  TP Code CPMD " 
~/scratch_f_m2pn/tp-abinitio-cpmd/cpmd/bin/cpmd_seq.x ../input/h2-md-5au.inp ~/scratch_f_m2pn/tp-abinitio-cpmd/cpmd/pseudo/  > output-test1


